<?xml version="1.0"?>
<package format="3">
  <name>realsense_pub</name>
  <version>0.0.1</version>
  <description>Minimal RealSense RGB publisher (compressed) using librealsense2.</description>

  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Required runtime dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- External dependencies assumed to be installed system-wide -->
  <exec_depend>librealsense2</exec_depend>
  <exec_depend>opencv4</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
