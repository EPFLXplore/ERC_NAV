<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="6" name="NavigateRecovery">

      <PipelineSequence name="NavigateWithStablePath">

      <RateController hz="1.0">
          <Sequence name="ComputeAndAcceptStableCandidate">
            <RestampGoal input_goal="{goal}"
                         output_goal="{current_goal}"/>

            <ComputePathToPose goal="{current_goal}"
                               path="{candidate_path}"
                               planner_id="GridBased"/>

            <!-- Tunables live in nav2_params (bt_navigator: accept_candidate_path.*) -->
            <AcceptCandidatePath current_path="{path}"
                                 candidate_path="{candidate_path}"
                                 output_path="{path}"/>

            <!-- Unused cost-blind alternative. To experiment, replace the
                 active AcceptCandidatePath above with this node.
            <AcceptCandidatePathStupid current_path="{path}"
                                       candidate_path="{candidate_path}"
                                       output_path="{path}"/>
            -->

          </Sequence>
        </RateController>

        <FollowPath path="{path}" controller_id="FollowPath"/>

      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>

        <Sequence name="ClearCostmaps">
          <ClearEntireCostmap name="ClearLocalCostmap"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap"
                              service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </ReactiveFallback>

    </RecoveryNode>

  </BehaviorTree>
</root>
