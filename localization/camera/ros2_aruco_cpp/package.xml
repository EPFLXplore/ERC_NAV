<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_aruco_cpp</name>
  <version>0.1.0</version>
  <description>C++ port of ROS2 ArUco multi-camera detection and pose estimation</description>
  <maintainer email="arno.laurie@epfl.ch">Arno Laurie</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ros2_aruco_interfaces</depend>
  <depend>message_filters</depend>
  <depend>custom_msg</depend>

  <build_depend>OpenCV</build_depend>
  <build_depend>eigen</build_depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
